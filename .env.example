WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 微信官方 API 云中转（可选）
# 桌面端“设置 → 系统设置 → 微信云中转”保存的配置优先级更高。
# 每位用户使用独立中转账号；密码不要提交到 Git。
WECHAT_RELAY_ENABLED=false
WECHAT_RELAY_URL=https://bluebloodlab.cn/wechat-relay
WECHAT_RELAY_USERNAME=
WECHAT_RELAY_PASSWORD=

# 国内大模型（推荐 DeepSeek / 通义；二选一或都填做主备）
DEEPSEEK_API_KEY=
QWEN_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=

# 可选
MANUS_API_KEY=
MANUS_API_BASE=https://api.manus.ai
GEMINI_API_KEY=
ASKMANY_API_KEY=
ASKMANY_API_BASE=https://api.askmany.ai
NOTIFY_WEBHOOK=

# 飞书机器人（可选）
# 桌面端保存的飞书配置优先级更高；这里用于首次启动或无界面部署。
# FEISHU_ENABLED 只接受 true/false、1/0、yes/no、on/off；不要填写其他值。
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# PostgreSQL（必填；应用不再创建或回退到本地 SQLite）
DATABASE_URL=postgresql://wechat_app:change-me@127.0.0.1:5432/wechat_publisher

# 登录会话（生产环境请改成长随机字符串）
AUTH_STORAGE_SECRET=change-this-before-production
# Keep false while serving plain HTTP. Set true only after HTTPS is enabled;
# doing so prevents the browser from sending the login cookie over HTTP.
AUTH_SESSION_COOKIE_SECURE=false
# 服务端敏感凭证加密密钥；生产环境必须使用独立生成的长随机值并妥善备份。
CREDENTIAL_ENCRYPTION_KEY=change-this-to-a-long-random-credential-key
# 为兼容旧部署保留；系统会始终按 true 执行，false 不再关闭认证。
AUTH_REQUIRED=true

# 桌面云端模式：配置后只打开线上工作台，不再启动本机 API/数据库。
# 必须使用 HTTPS；本地开发请留空。
WECHAT_PUBLISHER_REMOTE_URL=

# 线上工作台的公网 HTTPS 基址。评审链接和飞书 Webhook 回调地址使用此值；
# 未配置或不是公网 HTTPS 时，系统不会生成、复制不可用的飞书回调地址。
WECHAT_PUBLISHER_PUBLIC_UI_URL=
