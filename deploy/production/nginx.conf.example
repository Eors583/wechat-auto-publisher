server {
    listen 80;
    listen [::]:80;
    server_name publisher.bluebloodlab.cn;

    client_max_body_size 30m;

    location / {
        proxy_pass http://127.0.0.1:18775;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600;
    }
}

# Direct-IP production entry point. Keep PostgreSQL private.
server {
    listen 80;
    listen [::]:80;
    server_name 47.99.126.8;

    client_max_body_size 30m;

    location /admin/ {
        proxy_pass http://127.0.0.1:18777/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600;
    }

    location /publisher-api/ {
        proxy_pass http://127.0.0.1:18776/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:18775;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name api.bluebloodlab.cn;

    client_max_body_size 30m;

    location = /downloads/BlueBloodLab-Cockpit-Bridge-1.4.2.exe {
        alias /opt/wechat-publisher/shared/downloads/BlueBloodLab-Cockpit-Bridge-1.4.2.exe;
        default_type application/octet-stream;
        add_header Content-Disposition 'attachment; filename="BlueBloodLab-Cockpit-Bridge-1.4.2.exe"' always;
        add_header X-Content-Type-Options nosniff always;
    }

    # Keep the previous direct URL available for users who already received it.
    location = /downloads/BlueBloodLab-Cockpit-Bridge-1.4.1.exe {
        alias /opt/wechat-publisher/shared/downloads/BlueBloodLab-Cockpit-Bridge-1.4.1.exe;
        default_type application/octet-stream;
        add_header Content-Disposition 'attachment; filename="BlueBloodLab-Cockpit-Bridge-1.4.1.exe"' always;
        add_header X-Content-Type-Options nosniff always;
    }

    location /publisher/ {
        proxy_pass http://127.0.0.1:18778/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:18777/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600;
    }

    location / {
        proxy_pass http://127.0.0.1:18776;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600;
    }
}

